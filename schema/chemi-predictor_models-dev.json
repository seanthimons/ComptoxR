                            },
                            "smiles": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "id",
                            "smiles"
                          ],
                          "type": "object"
                        },
                        "type": "array"
                      },
                      "model_id": {
                        "type": "integer"
                      }
                    },
                    "required": [
                      "chemicals",
                      "model_id"
                    ],
                    "type": "object"
                  }
                ]
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {},
            "description": "Success"
          }
        },
        "summary": "Generate predictions for multiple molecules"
      }
    },
    "/api/predictor_models/version": {
