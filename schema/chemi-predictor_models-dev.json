                    ],
                    "type": "object"
                  },
                  {
                    "example": {
                      "chemicals": [
                        {
                          "id": 1,
                          "smiles": "CC(C)CCC(C)NC1=CC(=O)C(=CC1=O)NC1C=CC=CC=1"
                        },
                        {
                          "id": 2,
                          "smiles": "CCCCN"
