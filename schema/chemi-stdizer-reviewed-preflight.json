{
  "openapi": "3.1.0",
  "info": {
    "title": "Standardizer Module",
    "version": "1.0.0"
  },
  "servers": [
    {
      "description": "Default Server URL",
      "url": "/"
    }
  ],
  "paths": {
    "/api/stdizer/groups/preflight": {
      "post": {
        "operationId": "groupCreatePostMultipartPreflight",
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/LibraryGroupInfo"
                  },
                  "type": "array"
                }
              }
            },
            "description": "OK"
          }
        },
        "tags": [
          "library-controller"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "files[]"
                ],
                "properties": {
                  "files[]": {
                    "items": {
                      "format": "binary",
                      "type": "string"
                    },
                    "type": "array"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "LibraryGroupInfo": {
        "properties": {
          "acl": {
            "$ref": "#/components/schemas/ACL"
          },
          "description": {
            "type": "string"
          },
          "frozen": {
            "type": "boolean"
          },
          "id": {
            "type": "string"
          },
          "invalid": {
            "type": "boolean"
          },
          "invalidMessage": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "operationsNumber": {
            "format": "int32",
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "uniqueName": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "ACL": {
        "properties": {
          "access": {
            "enum": [
              "PUBLIC",
              "AUTHENTICATED",
              "PRIVATE"
            ],
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "read": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "write": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    }
  }
}
