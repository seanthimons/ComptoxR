{
  "components": {},
  "info": {
    "description": "API gateway to EPA predictions",
    "title": "Predictor 2.0",
    "version": "1.0"
  },
  "openapi": "3.0.3",
  "paths": {
    "/api/predictor/metadata": {
      "get": {
        "operationId": "app.get_metadata",
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/api/predictor/modelset_report/{report_id}": {
      "get": {
        "operationId": "app.get_modelset_report",
        "parameters": [
          {
            "in": "path",
            "name": "report_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    },
    "/api/predictor/predict": {
      "post": {
        "operationId": "app.post_predict",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          },
          "required": true,
          "x-body-name": "request"
        },
        "responses": {
          "200": {
            "content": {},
            "description": "Success"
          }
        }
      }
    },
    "/api/predictor/qmrf/{qmrf_id}": {
      "get": {
        "operationId": "app.get_qmrf",
        "parameters": [
          {
            "in": "path",
            "name": "qmrf_id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/pdf": {
                "schema": {
                  "format": "binary",
                  "type": "string"
                }
              }
            },
            "description": "Success"
          }
        }
      }
    },
    "/api/predictor/report": {
      "get": {
        "operationId": "webtest_report.generate_webtest_report",
        "parameters": [
          {
            "in": "query",
            "name": "model_id",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "smiles",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "format",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "text/html": {}
            },
            "description": "Success"
          }
        }
      }
    },
    "/api/predictor/version": {
      "get": {
        "operationId": "app.get_version",
        "responses": {
          "200": {
            "description": "Success"
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": ""
    }
  ]
}
