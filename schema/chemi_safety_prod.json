  "paths": {
    "/api/alerts/render": {
      "get": {
        "operationId": "render",
        "parameters": [
          {
            "in": "query",
            "name": "smiles",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "smirks",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "format",
            "required": false,
            "schema": {
              "default": "SVG",
              "enum": [
                "PNG",
                "SVG"
              ],
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "width",
            "required": false,
            "schema": {
              "format": "int32",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "height",
            "required": false,
            "schema": {
              "format": "int32",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "format": "byte",
                  "type": "string"
                }
              }
            },
            "description": "OK"
          }
        },
        "tags": [
          "render-controller"
        ]
      }
    },
