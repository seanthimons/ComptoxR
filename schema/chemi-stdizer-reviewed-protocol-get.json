{
  "info": {
    "title": "Standardizer Module",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/stdizer/protocols/{id}": {
      "get": {
        "operationId": "protocolGet",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "hidden",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "in": "query",
            "name": "components",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "in": "query",
            "name": "changed",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "in": "query",
            "name": "failed",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "in": "query",
            "name": "passed",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "format": "int32",
              "minimum": 0,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "size",
            "required": false,
            "schema": {
              "format": "int32",
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "sort",
            "required": false,
            "schema": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "style": "form",
            "explode": true,
            "allowEmptyValue": true
          }
        ],
        "responses": {
          "200": {
            "content": {
              "*/*": {
                "schema": {
                  "$ref": "#/components/schemas/Protocol"
                }
              }
            },
            "description": "OK"
          }
        },
        "tags": [
          "protocols-controller"
        ]
      }
    }
  },
  "servers": [
    {
      "url": "https://hcd.rtpnc.epa.gov"
    }
  ],
  "components": {
    "schemas": {
      "ACL": {
        "properties": {
          "access": {
            "enum": [
              "PUBLIC",
              "AUTHENTICATED",
              "PRIVATE"
            ],
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "read": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "write": {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "Change": {
        "properties": {
          "description": {
            "type": "string"
          },
          "flag": {
            "type": "string"
          },
          "invalid": {
            "type": "boolean"
          },
          "invalidMessage": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "type": {
            "enum": [
              "METHOD",
              "SMIRKS",
              "SMILES",
              "SMARTS",
              "GROUP",
              "REFERENCE"
            ],
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "Chemical": {
        "properties": {
          "additionalProps": {
            "additionalProperties": {},
            "type": "object"
          },
          "averageMass": {
            "format": "double",
            "type": "number"
          },
          "canonicalSmiles": {
            "type": "string"
          },
          "casrn": {
            "type": "string"
          },
          "chemId": {
            "type": "string"
          },
          "cid": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "image": {
            "type": "string"
          },
          "inchi": {
            "type": "string"
          },
          "inchiKey": {
            "type": "string"
          },
          "mol": {
            "type": "string"
          },
          "molFormula": {
            "type": "string"
          },
          "monoisotopicMass": {
            "format": "double",
            "type": "number"
          },
          "name": {
            "type": "string"
          },
          "sid": {
            "type": "string"
          },
          "smiles": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "ChemicalRecord": {
        "properties": {
          "chemical": {
            "$ref": "#/components/schemas/Chemical"
          },
          "ordinal": {
            "format": "int32",
            "type": "integer"
          },
          "properties": {
            "additionalProperties": {},
            "type": "object"
          },
          "rid": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "Issue": {
        "properties": {
          "message": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "INFO",
              "WARNING",
              "ERROR",
              "FATAL"
            ],
            "type": "string"
          }
        },
        "type": "object"
      },
      "Protocol": {
        "properties": {
          "acl": {
            "$ref": "#/components/schemas/ACL"
          },
          "changedNumber": {
            "format": "int32",
            "type": "integer"
          },
          "comment": {
            "type": "string"
          },
          "componentsNumber": {
            "format": "int32",
            "type": "integer"
          },
          "exception": {
            "type": "string"
          },
          "failedNumber": {
            "format": "int32",
            "type": "integer"
          },
          "filteredNumber": {
            "format": "int64",
            "type": "integer"
          },
          "hiddenNumber": {
            "format": "int32",
            "type": "integer"
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "options": {
            "$ref": "#/components/schemas/StdizerOptions"
          },
          "passedNumber": {
            "format": "int32",
            "type": "integer"
          },
          "records": {
            "items": {
              "$ref": "#/components/schemas/ProtocolRecord"
            },
            "type": "array"
          },
          "recordsNumber": {
            "format": "int32",
            "type": "integer"
          },
          "status": {
            "enum": [
              "NONE",
              "SUBMITTED",
              "PROCESSING",
              "SUCCEEDED",
              "FAILED"
            ],
            "type": "string"
          }
        },
        "type": "object"
      },
      "ProtocolRecord": {
        "properties": {
          "@id": {
            "format": "int32",
            "type": "integer"
          },
          "comment": {
            "type": "string"
          },
          "curationStatus": {
            "enum": [
              "NONE",
              "CORRECT",
              "INCORRECT",
              "QUESTIONABLE"
            ],
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "issues": {
            "items": {
              "$ref": "#/components/schemas/Issue"
            },
            "type": "array"
          },
          "original": {
            "$ref": "#/components/schemas/ChemicalRecord"
          },
          "parent": {
            "$ref": "#/components/schemas/ProtocolRecord"
          },
          "protocolId": {
            "type": "string"
          },
          "status": {
            "enum": [
              "ORIGINAL",
              "PASSED",
              "FAILED",
              "SKIPPED"
            ],
            "type": "string"
          },
          "transformLog": {
            "items": {
              "$ref": "#/components/schemas/StdizerRecord"
            },
            "type": "array"
          },
          "type": {
            "enum": [
              "ORIGINAL",
              "COMPONENT",
              "PARENT",
              "DUPLICATE"
            ],
            "type": "string"
          }
        },
        "type": "object"
      },
      "StdizerOptions": {
        "properties": {
          "recordId": {
            "type": "string"
          },
          "run": {
            "type": "string"
          },
          "workflow": {
            "type": "string"
          }
        },
        "type": "object"
      },
      "StdizerRecord": {
        "properties": {
          "change": {
            "$ref": "#/components/schemas/Change"
          },
          "chemical": {
            "$ref": "#/components/schemas/Chemical"
          },
          "ordinal": {
            "format": "int32",
            "type": "integer"
          },
          "properties": {
            "additionalProperties": {},
            "type": "object"
          },
          "rid": {
            "type": "string"
          }
        },
        "type": "object"
      }
    }
  }
}
